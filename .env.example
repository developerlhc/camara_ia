APP_NAME=Vigilay
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
VIGILAY_API_URL=http://localhost:8000
TZ=America/Lima
MYSQL_DATABASE=vigilay
MYSQL_USER=vigilay
MYSQL_PASSWORD=Dulcinea.1
MYSQL_ROOT_PASSWORD=Dulcinea.1
DATABASE_URL=mysql+pymysql://vigilay:CHANGE_ME_RANDOM_DATABASE_PASSWORD@localhost:3306/vigilay?charset=utf8mb4
# Alternativa para hosting que entrega una cadena ADO.NET. Si existe, BDMYSQL
# tiene prioridad sobre DATABASE_URL.
BDMYSQL=Server=mysql.example.net;Database=vigilay;Uid=vigilay;Pwd=CHANGE_ME
TEST_DATABASE_URL=mysql+pymysql://vigilay_test:CHANGE_ME_TEST_PASSWORD@localhost:3307/vigilay_test?charset=utf8mb4
SESSION_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS
INTERNAL_PROXY_SECRET=CHANGE_ME_ANOTHER_RANDOM_32_CHARACTERS
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
SESSION_COOKIE_NAME=vigilay_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
ENABLE_SIMULATOR=true
CAMERA_STORAGE=mysql
# Frigate es el único motor de IA en la instalación normal.
LOCAL_AI_ENABLED=false
# Mantener false cuando scripts/iniciar-agente-stream.ps1 ejecuta el agente dedicado.
START_STREAM_AGENT_WITH_LOCAL=false
RUN_HARDWARE_TESTS=false
BUNNY_ENABLED=false
IMOU_ENABLED=false
EZVIZ_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
FFMPEG_PATH=F:\ia\ffmpeg\bin\ffmpeg.exe
V380_DECODER_PATH=.local/v380-bridge/V380Decoder.exe
FRIGATE_API_URL=http://frigate:5000
FRIGATE_TIMEOUT_SECONDS=10
STREAM_IDLE_TIMEOUT_SECONDS=60
STREAM_START_TIMEOUT_SECONDS=15
# Producción: el agente exige MySQL con ssl_ca o ssl_verify_cert=true.

# Las cámaras y sus credenciales no se configuran aquí. Se guardan cifradas
# en MySQL desde la opción "Agregar cámara" de Vigilay.
# Aviso por WhatsApp al detectar una persona. Usa el número con código de país.
NOTIFY_URL=https://cenfelec.com/notificarmsg
NOTIFY_PHONE=
NOTIFY_MESSAGE=Alguien llegó a la tienda.
