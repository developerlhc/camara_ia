{
  "name": "vigilay-mobile",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "native:android": "npm run build && cap sync android",
    "native:ios": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.0"
  }
}
